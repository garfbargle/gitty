{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gitty-demo",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-demo",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "gitty.c0di.com",
      "custom_domain": true
    }
  ]
}

